{
  "name": "cs2-farm-panel",
  "version": "1.0.13",
  "description": "CS2 Case Farm Panel",
  "author": "Kemal237",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "chcp 65001 && electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --win --dir",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.kemal237.cs2farmpanel",
    "productName": "CS2 Farm Panel",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CS2 Farm Panel"
    },
    "publish": {
      "provider": "github",
      "owner": "Kemal237",
      "repo": "project-1",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron-updater": "^6.8.3",
    "globaloffensive": "^3.3.0",
    "p-queue": "^7.4.1",
    "socks-proxy-agent": "^8.0.3",
    "sql.js": "^1.12.0",
    "steam-totp": "^2.1.2",
    "steam-user": "^5.3.0",
    "steamcommunity": "^3.50.0",
    "winreg": "^1.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^28.3.3",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.344.0",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.2",
    "tailwindcss": "^3.4.1"
  }
}
